# Config file selection
# Path to the intent manager config file (LLM backend and intent database), relative to ./instore.
# Defaults to ./intents/config-docker.json in Docker and intents/config.json when run locally.
INSTORE_CONFIG=

# LLM backends
# Only required if using an auth-required vLLM endpoint
NT_BEARER_TOKEN=
# Only required if using the Gemini backend
GEMINI_API_KEY=

# Intent database (Neo4j)
# Optional, overrides the URL in the config file. docker-compose already sets it to the neo4j service
# KNOWLEDGE_GRAPH_NEO4J_URL=bolt://localhost:7687
# Optional, both default to neo4j. Uncomment only if your Neo4j instance requires other credentials
# KNOWLEDGE_GRAPH_NEO4J_USERNAME=
# KNOWLEDGE_GRAPH_NEO4J_PASSWORD=

# MOG API
# e.g., http://0.0.0.0:30070
MOG_API_URL=
# Set to true to plan against mock video data and log video moves instead of calling the MOG API
MOG_DRY_RUN=

# Intent manager API
# Optional, when set every route except /api/v1/health requires this key in the X-API-Key header.
# The UI then needs the same key in VITE_INTENT_MANAGER_API_KEY
INSTORE_API_KEY=
